__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
data/raw/
# Ignore generated outputs, but publish only the flat PNG masters in each
# company's png/ folder. Git won't descend into an ignored directory, so the
# company dir and its png/ dir must be re-included before the PNGs; the
# outputs/*/* rule keeps everything else (SVGs, JSON, per-quarter folders) out.
outputs/*
!outputs/*/
outputs/*/*
!outputs/*/png/
outputs/*/png/*
!outputs/*/png/*.png

